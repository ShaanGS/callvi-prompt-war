{
  "name": "callvi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "staff:grant": "tsx --conditions=react-server scripts/staff-grant.ts",
    "sarvam:config": "tsx --conditions=react-server scripts/sarvam-config.ts",
    "elevenlabs:configure": "tsx --conditions=react-server scripts/elevenlabs-configure.ts",
    "agent:eval-export": "tsx --conditions=react-server scripts/agent-eval-export.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:rehearsal": "tsx scripts/extract-preview.ts && node scripts/build-rehearsal.mjs",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@elevenlabs/client": "^1.33.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sarvam-conv-ai-sdk": "^0.0.42",
    "server-only": "^0.0.1",
    "speaker": "file:vendor/speaker-stub",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "speaker": "$speaker"
  }
}
