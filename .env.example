# Callvi — environment variables
# Copy to .env.local for development. Never commit real values.
# Everything without NEXT_PUBLIC_ is server-only and never reaches the browser.

# --- App -------------------------------------------------------------------
# Public HTTPS origin of the deployment. Used to generate Sarvam tool URLs.
APP_URL=

# --- Database --------------------------------------------------------------
# Supabase Postgres connection string (required in production).
# Use the transaction pooler (port 6543, host ...pooler.supabase.com) for Vercel.
# The PostgreSQL adapter disables prepared statements and query pipelining.
# Leave empty in development to use the embedded PGlite database in .data/pglite,
# which is migrated and seeded automatically on first request.
DATABASE_URL=
# Optional: directory for the embedded development database.
LOCAL_DB_DIR=

# --- Supabase Auth (email one-time code) ----------------------------------
# Required in production. Without these, development falls back to the
# development-only sign-in, which is refused when NODE_ENV=production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-only: lets "Delete my account" also delete the Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets (each at least 32 characters; required in production) --------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs voice-session tokens passed to Sarvam as the user identifier.
APP_SIGNING_SECRET=
# HMAC key for looking up phone callers. Raw numbers are never stored.
# Changing it makes returning callers unrecognisable.
PHONE_HASH_SECRET=

# --- Development-only sign-in ---------------------------------------------
# Enables the name-based development sign-in even when Supabase is configured.
# Startup fails if this is set in production.
DEV_AUTH_ENABLED=

# --- Sarvam Voice Agents ---------------------------------------------------
# Server-only. Used by the same-origin signed-URL proxy; never sent to the browser.
SARVAM_API_KEY=
# Optional override; defaults to the documented Sarvam API base URL.
SARVAM_API_BASE_URL=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Browser voice agent (app id and optional published version number).
SARVAM_WEB_APP_ID=
SARVAM_WEB_APP_VERSION=
# Phone agent (attached to the inbound number in the Sarvam dashboard).
SARVAM_PHONE_APP_ID=
# Bearer secrets the agents present to /api/voice/tools/* (one per agent, 32+ chars).
# Store each one as a workspace secret in Sarvam; never reuse one for both agents.
SARVAM_TOOL_SECRET_BROWSER=
SARVAM_TOOL_SECRET_PHONE=

# --- Phone channel ---------------------------------------------------------
# Set to true ONLY after a real inbound call AND a separate second-call resume
# test have passed. Until then, the phone option is not shown to learners.
PHONE_CHANNEL_VERIFIED=
# Number to show learners once verified, e.g. +91 44 0000 0000
PHONE_DISPLAY_NUMBER=

# --- ElevenLabs browser voice ---------------------------------------------
# Browser voice: ElevenLabs client tools work against localhost and production.
# Keep the API key server-side. Run scripts/elevenlabs-configure.ts to provision
# the agent and set its ID in .env.local.
BROWSER_VOICE_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Tests -----------------------------------------------------------------
# Port for the Playwright dev server (default 3100).
E2E_PORT=
